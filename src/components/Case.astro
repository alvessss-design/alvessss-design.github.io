---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Media from './Media.astro';
import {ui,projectPath,type Lang} from '../data/content';
import {projects,type Project} from '../data/projects';
import {projectVideoPath} from '../data/media';
interface Props{lang:Lang;project:Project}const {lang,project:p}=Astro.props;const t=ui[lang];const c=p.copy[lang];const related=projects.filter(project=>project.slug!==p.slug);const alternate=projectPath(lang==='pt'?'en':'pt',p.slug);const projectVideo=p.video||projectVideoPath(p.slug);const unmuteLabel=lang==='pt'?'Clique para ativar o som':'Click to unmute';const otherWorks=lang==='pt'?'Outros trabalhos':'Other work';const homeLabel=lang==='pt'?'Voltar à página inicial':'Back to homepage';
---
<Layout lang={lang} title={`${p.title} — KARU`} description={c.summary} alternate={alternate}><Header lang={lang} alternate={alternate}/><main id="main" class={`case case-${p.number}`}>
<article id="top" data-theme="dark"><div class="case-heading" id="project-details"><a class="text-link" href={`/${lang}?return=1#work`}>← {t.back}</a><div class="case-title-row"><h1>{p.title}</h1><span class="eyebrow">K—00{p.number.slice(-1)}<br/>{t.demo}</span></div><dl class="case-meta"><div><dt>{t.role}</dt><dd>KARU / {t.demo}</dd></div><div><dt>{t.discipline}</dt><dd>{c.discipline}</dd></div><div><dt>{t.year}</dt><dd>{p.year}</dd></div></dl></div>
<figure class="case-hero" id="project-film"><div class="case-player-frame"><div class="case-hero-media" data-player style={`view-transition-name:project-${p.slug}`}><Media src={p.image} alt={c.alt} video={projectVideo} priority/><button class="video-sound" type="button" data-unmute aria-label={unmuteLabel}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4Zm12.5-.5a5 5 0 0 1 0 7M19 6a8 8 0 0 1 0 12"/></svg><span>{unmuteLabel}</span></button></div></div></figure>
<section class="case-intro"><span class="eyebrow">01 / {t.concept}</span><div><h2>{c.summary}</h2><p>{c.concept}</p><p class="case-notice eyebrow">{t.statement}</p></div></section>
<section class="process"><div class="section-heading"><h2>{t.process}</h2><span class="eyebrow">02 / 03</span></div><p class="process-note">{t.workflowNote}</p><div class="process-grid">{c.steps.map((step,i)=><div><span class="eyebrow">0{i+1}</span><h3>{step.title}</h3><p>{step.text}</p></div>)}</div></section>
<section class="case-gallery" aria-label={t.detail}><figure class="detail-crop"><Media src={p.image} alt={`${c.alt} — ${t.detail}`}/><figcaption class="eyebrow">01 / {t.detail}</figcaption></figure><figure class="wide-crop"><Media src={p.image} alt={c.alt}/><figcaption class="eyebrow">02 / {t.final}</figcaption></figure></section>
<section class="case-credits"><h2>{t.credits}</h2><dl><div><dt>{t.contribution}</dt><dd>{c.contribution}</dd></div><div><dt>{t.tools}</dt><dd>{c.tools}</dd></div></dl></section>
</article><section class="next-project" data-theme="light"><span class="eyebrow">{otherWorks}</span><div class="related-projects" aria-label={otherWorks}>{related.map(project=>{const copy=project.copy[lang];const previewVideo=project.video||projectVideoPath(project.slug);return <a class="related-project" href={projectPath(lang,project.slug)} aria-label={`${lang==='pt'?'Abrir projeto':'Open project'} ${project.title}`}><span class="related-media"><video src={previewVideo} poster={project.image} muted playsinline loop autoplay preload="metadata" data-video></video><span class="project-number eyebrow">K—00{project.number.slice(-1)}</span><span class="related-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8"/></svg></span></span><span class="related-meta"><strong>{project.title}</strong><span class="eyebrow">{project.number} / {copy.discipline}</span></span></a>})}</div><a class="text-link" href={`/${lang}`}>← {homeLabel}</a></section></main><footer><a class="footer-brand" href={`/${lang}`}>KARU</a><span class="eyebrow">© 2026</span><a class="text-link" href="#top">{t.top} ↑</a></footer></Layout>
