---
import {ui,type Lang} from '../data/content';
interface Props{lang:Lang;alternate?:string;home?:boolean}
const {lang,alternate=lang==='pt'?'/en':'/pt',home=false}=Astro.props;const t=ui[lang];const base=home?'':`/${lang}`;
const links=[{id:'work',text:t.works},{id:'about',text:t.about},{id:'contact',text:t.contact}];
---
<header class="site-header" data-theme="dark"><nav class="nav-side" aria-label={t.nav}>{links.slice(0,2).map(link=><a class="nav-link" data-section={link.id} aria-label={link.text} href={`${base}#${link.id}`}><span class="scramble" data-text={link.text} aria-hidden="true"><span class="measure">{link.text}</span><span class="scramble-text">{link.text}</span></span></a>)}</nav><a class="wordmark" href={`${base}#top`} aria-label={`KARU — ${t.top}`}>KARU</a><div class="nav-side nav-right"><a class="nav-link" data-section="contact" aria-label={t.contact} href={`${base}#contact`}><span class="scramble" data-text={t.contact} aria-hidden="true"><span class="measure">{t.contact}</span><span class="scramble-text">{t.contact}</span></span></a><div class="languages" aria-label="Idioma / Language"><a data-language={lang==='pt'?undefined:''} href={lang==='pt'?Astro.url.pathname:alternate} aria-current={lang==='pt'?'page':undefined} lang="pt-BR" aria-label="Português"><span class="scramble" data-text="PT" aria-hidden="true"><span class="measure">PT</span><span class="scramble-text">PT</span></span></a><span aria-hidden="true">/</span><a data-language={lang==='en'?undefined:''} href={lang==='en'?Astro.url.pathname:alternate} aria-current={lang==='en'?'page':undefined} lang="en" aria-label="English"><span class="scramble" data-text="EN" aria-hidden="true"><span class="measure">EN</span><span class="scramble-text">EN</span></span></a></div></div><button class="menu-button" aria-haspopup="dialog" aria-controls="mobile-menu" aria-expanded="false">Menu <span aria-hidden="true">＋</span></button></header>
<dialog id="mobile-menu" class="mobile-menu" aria-label={t.nav}><div class="menu-head"><span class="wordmark">KARU</span><button class="menu-close">{t.close} ×</button></div><nav>{links.map(link=><a href={`${base}#${link.id}`}>{link.text} ↗</a>)}</nav><div class="languages"><a data-language={lang==='pt'?undefined:''} href={lang==='pt'?Astro.url.pathname:alternate} aria-current={lang==='pt'?'page':undefined}>PT</a><span>/</span><a data-language={lang==='en'?undefined:''} href={lang==='en'?Astro.url.pathname:alternate} aria-current={lang==='en'?'page':undefined}>EN</a></div></dialog>
